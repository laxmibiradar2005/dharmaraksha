flowchart TD
  %% Subgraph 1: User Peripherals
  subgraph Peripherals ["Physical Peripherals & User Devices"]
    phone["Phone Browser (Visitor Kiosk UI)"]
    esp32["ESP32-S3 (RC522 RFID + TFT Display)"]
    camera["USB Document Camera (/dev/video0)"]
    mic["USB Microphone (ALSA plughw:1,0)"]
    speaker["Mivi Roam 2 (Bluetooth Audio)"]
  end

  %% Subgraph 2: Tier 1 Edge Node
  subgraph Tier1 ["Tier 1: Edge Gateway (Arduino UNO Q - ARM64 Linux)"]
    direction TB
    gateway["Node 22 Express Gateway (Port 3001)"]
    kiosk_api["Kiosk Hardware Bridges (Camera / Audio / RFID)"]
    mem_session["Volatile In-Memory Session Cache"]
    local_llm["Emergency Offline Fallback: llama.cpp (Port 8081)\nModel: Qwen-0.6B Q4_K_M.gguf"]
  end

  %% Subgraph 3: Tier 2 Local RAG Node
  subgraph Tier2 ["Tier 2: Local Edge Server (Laptop on LAN - Port 3002)"]
    direction TB
    rag_service["Authenticated RAG Service (/query, /search)"]
    embed_model["Local Multilingual MiniLM (384-dim CPU Embeddings)"]
    subgraph Storage ["Embedded Vector Storage (PGlite)"]
      pgvector["pgvector HNSW Index (3,471 Chunks / 16 Gazette Acts)"]
      fts["PostgreSQL Full-Text Search (ts_rank_cd)"]
    end
    rrf["Reciprocal Rank Fusion (RRF) & Act Routing"]
  end

  %% Subgraph 4: Tier 3 Cloud Services
  subgraph Tier3 ["Tier 3: Cloud Intelligence & Regional Voice"]
    direction TB
    budget_ledger["Economy Guardrail (₹20/Day, ₹400 Cycle Cap)"]
    gemini["Gemini 2.5 Flash-Lite (Grounded Synthesis)"]
    cite_verifier["Deterministic Citation Validator (Regex [S#] Check)"]
    sarvam["Sarvam AI Bulbul v4 (Kannada / Hindi / Tamil TTS)"]
    firebase["Firebase (Encrypted User Vaults)"]
  end

  %% Data Flow Connections
  phone <-->|"Wi-Fi HTTP / Kiosk Web App"| gateway
  esp32 -->|"Device-Authenticated Serial / HTTP"| kiosk_api
  camera -->|"Local MJPEG Stream"| kiosk_api
  mic -->|"Audio Capture"| kiosk_api
  gateway -->|"ALSA / WirePlumber Audio"| speaker

  gateway --> kiosk_api
  kiosk_api --> mem_session

  %% Online vs Offline Path
  gateway -->|"Authenticated Bearer Query (LAN:3002)"| rag_service
  gateway -.->|"Network / Cloud Failure Fallback"| local_llm

  rag_service --> embed_model
  embed_model --> pgvector
  rag_service --> fts
  pgvector --> rrf
  fts --> rrf

  rrf -->|"Top Verified Legal Excerpts [S1-S6]"| budget_ledger
  budget_ledger --> gemini
  gemini --> cite_verifier
  cite_verifier -->|"Verified Synthesized Answer"| rag_service
  rag_service -->|"Grounded Response + Page Sources"| gateway

  gateway -->|"Synthesize Regional Speech"| sarvam
  sarvam -->|"Streaming Audio Response"| speaker
  gateway -.->|"Encrypted Case Backup"| firebase

  %% Styling
  classDef edgeNode fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;
  classDef ragNode fill:#ede7f6,stroke:#512da8,stroke-width:2px;
  classDef cloudNode fill:#fff3e0,stroke:#f57c00,stroke-width:2px;
  classDef hardware fill:#f5f5f5,stroke:#616161,stroke-width:1.5px;

  class phone,esp32,camera,mic,speaker hardware;
  class gateway,kiosk_api,mem_session,local_llm edgeNode;
  class rag_service,embed_model,pgvector,fts,rrf ragNode;
  class budget_ledger,gemini,cite_verifier,sarvam,firebase cloudNode;
