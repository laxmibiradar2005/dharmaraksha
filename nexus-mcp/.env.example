NEWS_API_KEY=your_newsapi_org_key
FACTCHECK_API_KEY=your_google_factcheck_api_key
HIBP_API_KEY=your_haveibeenpwned_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_google_gemini_api_key
PORT=3001

# Kiosk providers (server-side only). Keep LOCAL_LLM_URL unset until deployed.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_SPEAKER=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=local
LOCAL_LLM_API_KEY=
# Optional laptop service: POST {RAG_SERVER_URL}/query -> {reply, sources}
RAG_SERVER_URL=
RAG_SERVER_TOKEN=

# Economy mode: local estimates, not provider-account billing limits
ECONOMY_MODE=true
RAG_ENABLED=true
LEGAL_ASSISTANT_MODEL=gemini-2.5-flash-lite
AI_BUDGET_INR=400
AI_DAILY_BUDGET_INR=20
AI_BUDGET_CYCLE=prototype-2026-11

# Laptop public-law RAG (leave disabled on the small kiosk)
RAG_STORAGE=pglite
RAG_PGLITE_PATH=data/legal-postgres
RAG_MODEL_CACHE=data/models
RAG_MODEL_OFFLINE=false
RAG_PORT=3002
# RAG_DATABASE_URL=postgresql://user:password@127.0.0.1:5433/dharmaraksha
# RAG_SERVER_URL=http://127.0.0.1:3002
# RAG_SERVER_TOKEN=<private-random-token-at-least-32-characters>
